{
  "name": "prism-teleport",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "test:contracts": "cd contracts && forge test",
    "test:contracts:fuzz": "cd contracts && forge test --fuzz-runs 10000"
  }
}
