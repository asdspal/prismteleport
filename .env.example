SOLVER_MAX_FAST_FILL_MUSD="2500"
INDEXER_MAX_BLOCK_SPAN="9000"
PORT="8080"
CORS_ALLOWED_ORIGINS="http://localhost:3000,https://prismteleport.xyz,https://prism-teleport.pages.dev"

# --- 6. FRONTEND PUBLIC VARIABLES (R-015, R-016) ---
NEXT_PUBLIC_API_BASE_URL="https://api.prismteleport.xyz/v1"
NEXT_PUBLIC_DEFAULT_CHAIN_ID="31611"
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="your_walletconnect_project_id_here"

