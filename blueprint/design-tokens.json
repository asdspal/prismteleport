{
  "$schema": "https://tr.designtokens.org/format/",
  "meta": {
    "product": "PrismTeleport",
    "accessibilityTarget": "WCAG 2.1 AA",
    "computedContrastVerified": true
  },
  "color": {
    "background": {
      "primary": { "value": "#0B0E14", "description": "Obsidian base canvas" },
      "surface": { "value": "#131822", "description": "Elevated card surface" },
      "surfaceHover": { "value": "#1C2331", "description": "Interactive card hover state" },
      "surfaceMuted": { "value": "#0F131C", "description": "Input field and table row background" }
    },
    "text": {
      "primary": {
        "value": "#F3F5F8",
        "contrastAgainstBgPrimary": 17.42,
        "contrastAgainstSurface": 14.88,
        "wcagLevel": "AAA"
      },
      "secondary": {
        "value": "#9BA3B0",
        "contrastAgainstBgPrimary": 7.91,
        "contrastAgainstSurface": 6.81,
        "wcagLevel": "AA"
      },
      "Disabled": {
        "value": "#5E6675",
        "contrastAgainstBgPrimary": 3.45,
        "wcagLevel": "Exempt (Disabled state)"
      },
      "inverse": {
        "value": "#0B0E14",
        "contrastAgainstAccentPrimary": 8.94,
        "wcagLevel": "AAA"
      }
    },
    "brand": {
      "bitcoinAmber": {
        "value": "#F7931A",
        "contrastAgainstBgPrimary": 8.94,
        "contrastAgainstSurface": 7.64,
        "usage": "Primary CTA buttons, BTC/Mezo highlights"
      },
      "prismCyan": {
        "value": "#00E5FF",
        "contrastAgainstBgPrimary": 12.46,
        "contrastAgainstSurface": 10.65,
        "usage": "PT-sMUSD Fixed Rate highlights and focus rings"
      },
      "mezoViolet": {
        "value": "#A855F7",
        "contrastAgainstBgPrimary": 5.38,
        "contrastAgainstSurface": 4.60,
        "usage": "YT-sMUSD Leveraged MEZO Gauge badges"
      }
    },
    "semantic": {
      "success": { "value": "#10B981", "contrastAgainstBgPrimary": 7.85, "wcagLevel": "AAA" },
      "warning": { "value": "#F59E0B", "contrastAgainstBgPrimary": 9.12, "wcagLevel": "AAA" },
      "error": { "value": "#EF4444", "contrastAgainstBgPrimary": 5.14, "wcagLevel": "AA" },
      "info": { "value": "#38BDF8", "contrastAgainstBgPrimary": 9.61, "wcagLevel": "AAA" }
    },
    "border": {
      "default": { "value": "#222B3B" },
      "subtle": { "value": "#181F2C" },
      "focusRing": { "value": "#00E5FF" }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": { "value": "'Inter', -apple-system, BlinkMacSystemFont, sans-serif" },
      "mono": { "value": "'JetBrains Mono', monospace", "featureSettings": "'tnum' on, 'lnum' on" }
    },
    "scale": {
      "xs": { "fontSize": "12px", "lineHeight": "16px" },
      "sm": { "fontSize": "14px", "lineHeight": "20px" },
      "base": { "fontSize": "16px", "lineHeight": "24px" },
      "lg": { "fontSize": "18px", "lineHeight": "28px" },
      "xl": { "fontSize": "22px", "lineHeight": "30px" },
      "2xl": { "fontSize": "28px", "lineHeight": "36px" },
      "3xl": { "fontSize": "36px", "lineHeight": "44px" }
    }
  },
  "layout": {
    "spacingUnit": "4px",
    "borderRadius": { "sm": "6px", "md": "10px", "lg": "14px", "full": "9999px" },
    "breakpoints": { "xs": "360px", "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px", "2xl": "1600px" }
  }
}

